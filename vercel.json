{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "biodentweb.vercel.app" }],
      "destination": "https://www.biodent.site/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "biodent.site" }],
      "destination": "https://www.biodent.site/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}
